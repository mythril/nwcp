{
  "name": "nwcp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && rm -f nwcp/*test.html",
    "preview": "vite preview",
    "test": "npm run test:unit #npm run test:integration && ",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --plugin-search-dir . --check . && eslint .",
    "full-check": "npm run format && npm run lint && npm run check && npm run test",
    "format": "prettier --plugin-search-dir . --write .",
    "test:integration": "playwright test",
    "test:unit": "vitest run",
    "release": "npm run full-check && npm run build && zip -r nwcp-release-`git describe --always HEAD`.zip nwcp"
  },
  "devDependencies": {
    "@davidwells/postcss-math": "^1.0.3",
    "@faker-js/faker": "^8.0.2",
    "@playwright/test": "1.36.2",
    "@sveltejs/adapter-auto": "2.1.0",
    "@sveltejs/adapter-static": "2.0.3",
    "@sveltejs/kit": "1.22.4",
    "@typescript-eslint/eslint-plugin": "6.2.1",
    "@typescript-eslint/parser": "6.3.0",
    "@vite-pwa/sveltekit": "^0.2.5",
    "autoprefixer": "^10.4.14",
    "cssnano": "^6.0.1",
    "eslint": "8.46.0",
    "eslint-config-prettier": "9.0.0",
    "eslint-plugin-svelte": "2.32.4",
    "postcss": "^8.4.27",
    "postcss-load-config": "^4.0.1",
    "postcss-nested": "^6.0.1",
    "prettier-plugin-svelte": "3.0.3",
    "svelte": "4.1.2",
    "svelte-check": "^3.4.6",
    "tsafe": "^1.6.4",
    "tslib": "2.6.1",
    "typescript": "5.1.6",
    "vite": "4.4.9",
    "vitest": "0.34.1"
  },
  "type": "module"
}