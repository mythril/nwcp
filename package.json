{
  "name": "nwcp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && rm -f nwcp/*test.html",
    "preview": "vite preview",
    "test": "npm run test:unit #npm run test:integration && ",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --plugin-search-dir . --check . && eslint .",
    "full-check": "npm run format && npm run lint && npm run check && npm run test",
    "format": "prettier --plugin-search-dir . --write .",
    "test:integration": "playwright test",
    "test:unit": "vitest run",
    "release": "npm run full-check && npm run build && zip -r nwcp-release-`git describe --always HEAD`.zip nwcp"
  },
  "devDependencies": {
    "@davidwells/postcss-math": "^1.0.3",
    "@faker-js/faker": "8.4.1",
    "@playwright/test": "1.42.1",
    "@sveltejs/adapter-auto": "3.1.1",
    "@sveltejs/adapter-static": "3.0.1",
    "@sveltejs/kit": "2.5.2",
    "@sveltejs/vite-plugin-svelte": "3.0.2",
    "@typescript-eslint/eslint-plugin": "7.1.1",
    "@typescript-eslint/parser": "7.1.1",
    "@vite-pwa/sveltekit": "0.4.0",
    "autoprefixer": "10.4.18",
    "cssnano": "6.1.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-svelte": "2.35.1",
    "postcss": "8.4.35",
    "postcss-load-config": "5.0.3",
    "postcss-nested": "^6.0.1",
    "prettier-plugin-svelte": "3.2.2",
    "svelte": "4.2.12",
    "svelte-check": "3.6.6",
    "tsafe": "1.6.6",
    "tslib": "2.6.2",
    "typescript": "5.4.2",
    "vite": "5.1.5",
    "vitest": "1.3.1"
  },
  "type": "module"
}