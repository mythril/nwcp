{
  "name": "nwcp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && rm -f nwcp/*test.html",
    "preview": "vite preview",
    "test": "npm run test:unit #npm run test:integration && ",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --plugin-search-dir . --check . && eslint .",
    "full-check": "npm run format && npm run lint && npm run check && npm run test",
    "format": "prettier --plugin-search-dir . --write .",
    "test:integration": "playwright test",
    "test:unit": "vitest run",
    "release": "npm run full-check && npm run build && zip -r nwcp-release-`git describe --always HEAD`.zip nwcp"
  },
  "devDependencies": {
    "@davidwells/postcss-math": "^1.0.3",
    "@faker-js/faker": "9.0.3",
    "@playwright/test": "1.48.1",
    "@sveltejs/adapter-auto": "3.2.5",
    "@sveltejs/adapter-static": "3.0.5",
    "@sveltejs/kit": "2.7.2",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@typescript-eslint/eslint-plugin": "8.10.0",
    "@typescript-eslint/parser": "8.10.0",
    "@vite-pwa/sveltekit": "0.6.6",
    "autoprefixer": "10.4.20",
    "cssnano": "7.0.6",
    "eslint": "9.13.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-svelte": "2.45.1",
    "postcss": "8.4.47",
    "postcss-load-config": "6.0.1",
    "postcss-nested": "6.2.0",
    "prettier-plugin-svelte": "3.2.7",
    "svelte": "5.0.2",
    "svelte-check": "4.0.5",
    "tsafe": "1.7.5",
    "tslib": "2.8.0",
    "typescript": "5.6.3",
    "vite": "5.4.9",
    "vitest": "2.1.3"
  },
  "type": "module"
}