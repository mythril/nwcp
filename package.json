{
  "name": "nwcp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && rm -f nwcp/*test.html",
    "preview": "vite preview",
    "test": "npm run test:unit #npm run test:integration && ",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --plugin-search-dir . --check . && eslint .",
    "full-check": "npm run format && npm run lint && npm run check && npm run test",
    "format": "prettier --plugin-search-dir . --write .",
    "test:integration": "playwright test",
    "test:unit": "vitest run",
    "release": "npm run full-check && npm run build && zip -r nwcp-release-`git describe --always HEAD`.zip nwcp"
  },
  "devDependencies": {
    "@davidwells/postcss-math": "^1.0.3",
    "@faker-js/faker": "9.8.0",
    "@playwright/test": "1.52.0",
    "@sveltejs/adapter-auto": "6.0.1",
    "@sveltejs/adapter-static": "3.0.8",
    "@sveltejs/kit": "2.21.3",
    "@sveltejs/vite-plugin-svelte": "5.1.0",
    "@typescript-eslint/eslint-plugin": "8.33.1",
    "@typescript-eslint/parser": "8.33.1",
    "@vite-pwa/sveltekit": "1.0.0",
    "autoprefixer": "10.4.21",
    "cssnano": "7.0.7",
    "eslint": "9.28.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-svelte": "3.9.1",
    "postcss": "8.5.4",
    "postcss-load-config": "6.0.1",
    "postcss-nested": "7.0.2",
    "prettier-plugin-svelte": "3.4.0",
    "svelte": "5.33.18",
    "svelte-check": "4.2.1",
    "tsafe": "1.8.5",
    "tslib": "2.8.1",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.2"
  },
  "type": "module"
}