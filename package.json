{
  "name": "nwcp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && rm -f nwcp/*test.html",
    "preview": "vite preview",
    "test": "npm run test:unit #npm run test:integration && ",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --plugin-search-dir . --check . && eslint .",
    "full-check": "npm run format && npm run lint && npm run check && npm run test",
    "format": "prettier --plugin-search-dir . --write .",
    "test:integration": "playwright test",
    "test:unit": "vitest run",
    "release": "npm run full-check && npm run build && zip -r nwcp-release-`git describe --always HEAD`.zip nwcp"
  },
  "devDependencies": {
    "@davidwells/postcss-math": "^1.0.3",
    "@faker-js/faker": "9.6.0",
    "@playwright/test": "1.51.0",
    "@sveltejs/adapter-auto": "4.0.0",
    "@sveltejs/adapter-static": "3.0.8",
    "@sveltejs/kit": "2.19.2",
    "@sveltejs/vite-plugin-svelte": "5.0.3",
    "@typescript-eslint/eslint-plugin": "8.26.1",
    "@typescript-eslint/parser": "8.26.1",
    "@vite-pwa/sveltekit": "0.6.7",
    "autoprefixer": "10.4.21",
    "cssnano": "7.0.6",
    "eslint": "9.22.0",
    "eslint-config-prettier": "10.1.1",
    "eslint-plugin-svelte": "3.3.0",
    "postcss": "8.5.3",
    "postcss-load-config": "6.0.1",
    "postcss-nested": "7.0.2",
    "prettier-plugin-svelte": "3.3.3",
    "svelte": "5.23.1",
    "svelte-check": "4.1.5",
    "tsafe": "1.8.5",
    "tslib": "2.8.1",
    "typescript": "5.8.2",
    "vite": "6.2.2",
    "vitest": "3.0.9"
  },
  "type": "module"
}