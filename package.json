{
  "name": "nwcp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && rm -f nwcp/*test.html",
    "preview": "vite preview",
    "test": "npm run test:unit #npm run test:integration && ",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --plugin-search-dir . --check . && eslint .",
    "full-check": "npm run format && npm run lint && npm run check && npm run test",
    "format": "prettier --plugin-search-dir . --write .",
    "test:integration": "playwright test",
    "test:unit": "vitest run",
    "release": "npm run full-check && npm run build && zip -r nwcp-release-`git describe --always HEAD`.zip nwcp"
  },
  "devDependencies": {
    "@davidwells/postcss-math": "^1.0.3",
    "@faker-js/faker": "10.0.0",
    "@playwright/test": "1.55.0",
    "@sveltejs/adapter-auto": "6.1.0",
    "@sveltejs/adapter-static": "3.0.9",
    "@sveltejs/kit": "2.37.1",
    "@sveltejs/vite-plugin-svelte": "6.2.0",
    "@typescript-eslint/eslint-plugin": "8.43.0",
    "@typescript-eslint/parser": "8.43.0",
    "@vite-pwa/sveltekit": "1.0.0",
    "autoprefixer": "10.4.21",
    "cssnano": "7.1.1",
    "eslint": "9.35.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.12.2",
    "postcss": "8.5.6",
    "postcss-load-config": "6.0.1",
    "postcss-nested": "7.0.2",
    "prettier-plugin-svelte": "3.4.0",
    "svelte": "5.38.8",
    "svelte-check": "4.3.1",
    "tsafe": "1.8.10",
    "tslib": "2.8.1",
    "typescript": "5.9.2",
    "vite": "7.1.5",
    "vitest": "3.2.4"
  },
  "type": "module"
}