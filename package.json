{
  "name": "nwcp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && rm -f nwcp/*test.html",
    "preview": "vite preview",
    "test": "npm run test:unit #npm run test:integration && ",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "full-check": "npm run format && npm run lint && npm run check && npm run test",
    "format": "prettier --write .",
    "test:integration": "playwright test",
    "test:unit": "vitest run",
    "release": "npm run full-check && npm run build && zip -r nwcp-release-`git describe --always HEAD`.zip nwcp"
  },
  "devDependencies": {
    "@davidwells/postcss-math": "^1.0.3",
    "@faker-js/faker": "10.3.0",
    "@playwright/test": "1.58.2",
    "@sveltejs/adapter-auto": "7.0.0",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.50.2",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@typescript-eslint/eslint-plugin": "8.54.0",
    "@typescript-eslint/parser": "8.54.0",
    "@vite-pwa/sveltekit": "1.1.0",
    "autoprefixer": "10.4.24",
    "cssnano": "7.1.2",
    "eslint": "10.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.14.0",
    "postcss": "8.5.6",
    "postcss-load-config": "6.0.1",
    "postcss-nested": "7.0.2",
    "prettier-plugin-svelte": "3.4.1",
    "svelte": "5.50.0",
    "svelte-check": "4.3.6",
    "tsafe": "1.8.12",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  },
  "type": "module"
}